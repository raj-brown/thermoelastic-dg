{
  "workbench.colorTheme": "Dark Modern",
  "workbench.sideBar.location": "left",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.enablePreview": false,
  "workbench.startupEditor": "none",
  "workbench.list.smoothScrolling": true,
  "workbench.tree.indent": 12,
  "workbench.tree.renderIndentGuides": "always",
  "editor.fontFamily": "JetBrains Mono, SF Mono, Menlo, Monaco, monospace",
  "editor.fontSize": 16,
  "editor.lineHeight": 1.6,
  "editor.letterSpacing": 0.2,
  "editor.fontLigatures": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": true,
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.renderWhitespace": "selection",
  "editor.renderControlCharacters": false,
  "editor.rulers": [88, 120],
  "editor.wordWrap": "off",
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true
  },
  "search.exclude": {
    "**/Manifest.toml": true,
    "**/output": true
  },
  "explorer.compactFolders": false,
  "terminal.integrated.fontFamily": "JetBrains Mono, SF Mono, Menlo, Monaco, monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.lineHeight": 1.35,
  "terminal.integrated.cursorBlinking": true,
  "[julia]": {
    "editor.defaultFormatter": "julialang.language-julia",
    "editor.formatOnSave": false,
    "editor.semanticHighlighting.enabled": true
  },
  "julia.executablePath": "/opt/homebrew/bin/julia",
  "workbench.colorCustomizations": {
    "editor.background": "#10161a",
    "editor.foreground": "#d7e2e5",
    "editorLineNumber.foreground": "#53666d",
    "editorLineNumber.activeForeground": "#9bb9b8",
    "editor.lineHighlightBackground": "#182328",
    "editor.selectionBackground": "#244b52",
    "editor.inactiveSelectionBackground": "#1d363b",
    "editorCursor.foreground": "#7dd3c7",
    "editorIndentGuide.background1": "#203136",
    "editorIndentGuide.activeBackground1": "#477176",
    "editorBracketHighlight.foreground1": "#7dd3c7",
    "editorBracketHighlight.foreground2": "#f2c879",
    "editorBracketHighlight.foreground3": "#e89b8c",
    "sideBar.background": "#0d1316",
    "sideBar.border": "#203136",
    "activityBar.background": "#0b1012",
    "activityBar.foreground": "#b8d8d5",
    "activityBar.inactiveForeground": "#607378",
    "titleBar.activeBackground": "#0b1012",
    "titleBar.activeForeground": "#d7e2e5",
    "tab.activeBackground": "#182328",
    "tab.activeForeground": "#e5f2f0",
    "tab.inactiveBackground": "#10161a",
    "tab.inactiveForeground": "#71848a",
    "panel.background": "#0d1316",
    "panel.border": "#203136",
    "statusBar.background": "#12383b",
    "statusBar.foreground": "#d9f0ed",
    "terminal.background": "#0b1012",
    "terminal.foreground": "#c9d9d8",
    "focusBorder": "#5bb7ad"
  }
}
